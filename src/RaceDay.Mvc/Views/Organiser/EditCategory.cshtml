@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}
<div class="mb-2"><a asp-action="Categories" asp-route-eventId="@Model.EventId" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Categories</a></div>
<h1 class="rd-page-title">Edit <span>category</span></h1>

<div class="rd-panel rd-auth-wide">
    <p class="text-muted">Event: @ViewData["EventName"]</p>
    <form asp-action="EditCategory" asp-route-id="@Model.CategoryId" asp-route-eventId="@Model.EventId" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-6 mb-3">
                <label asp-for="MinAge" class="form-label"></label>
                <input asp-for="MinAge" type="number" min="0" max="120" class="form-control" />
                <span asp-validation-for="MinAge" class="text-danger"></span>
            </div>
            <div class="col-6 mb-3">
                <label asp-for="MaxAge" class="form-label"></label>
                <input asp-for="MaxAge" type="number" min="0" max="120" class="form-control" />
                <span asp-validation-for="MaxAge" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="DistanceKm" class="form-label"></label>
            <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
            <span asp-validation-for="DistanceKm" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-rd">Save changes</button>
            <a asp-action="Categories" asp-route-eventId="@Model.EventId" class="btn btn-outline-rd">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
