@model EnrolmentsViewModel
@{
    ViewData["Title"] = "Enrolments";
    var ev = Model.Event;
}
<div class="mb-2"><a asp-action="Events" class="text-decoration-none"><i class="bi bi-arrow-left"></i> My events</a></div>
<h1 class="rd-page-title">Enrolments <span>&middot; @ev.Name</span></h1>
<p class="text-muted">@ViewHelpers.FormatDate(ev.EventDate) &middot; @ev.Location &middot; @Model.Enrolments.Count entered</p>

@if (Model.Enrolments.Count == 0)
{
    <div class="rd-panel text-center">
        <i class="bi bi-people display-4 text-muted"></i>
        <h3 class="mt-2">No one has entered yet</h3>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead>
                <tr><th>Participant</th><th>Email</th><th>Category</th><th>Entered</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    <tr>
                        <td class="fw-semibold">@e.ParticipantName</td>
                        <td>@e.ParticipantEmail</td>
                        <td>@e.CategoryName</td>
                        <td>@ViewHelpers.FormatShortDate(e.EnrolmentDate)</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
