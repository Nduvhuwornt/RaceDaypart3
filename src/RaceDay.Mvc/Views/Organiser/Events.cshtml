@model List<EventSummary>
@{
    ViewData["Title"] = "My events";
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="rd-page-title mb-0">My <span>events</span></h1>
    <a asp-action="CreateEvent" class="btn btn-rd"><i class="bi bi-plus-circle"></i> Create event</a>
</div>

@if (Model.Count == 0)
{
    <div class="rd-panel text-center">
        <i class="bi bi-calendar-plus display-4 text-muted"></i>
        <h3 class="mt-2">No events yet</h3>
        <p class="text-muted">Create your first event and add categories so participants can enter.</p>
        <a asp-action="CreateEvent" class="btn btn-rd">Create event</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead>
                <tr><th>Event</th><th>Type</th><th>Date</th><th>Location</th><th class="text-center">Entries</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId" class="text-decoration-none">@ev.Name</a>
                        </td>
                        <td><span class="badge rd-type @ViewHelpers.TypeCss(ev.EventType)"><i class="bi @ViewHelpers.TypeIcon(ev.EventType)"></i> @ev.EventType</span></td>
                        <td>@ViewHelpers.FormatShortDate(ev.EventDate)</td>
                        <td>@ev.Location</td>
                        <td class="text-center"><span class="badge rd-distance">@ev.EnrolmentCount</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-rd" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Categories" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-rd" title="Categories"><i class="bi bi-tags"></i></a>
                            <a asp-action="Enrolments" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-rd" title="Enrolments"><i class="bi bi-people"></i></a>
                            <a asp-action="Results" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-rd" title="Results"><i class="bi bi-stopwatch"></i></a>
                            <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" class="d-inline" data-confirm="Delete '@ev.Name'? This also removes its categories, enrolments and results.">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
