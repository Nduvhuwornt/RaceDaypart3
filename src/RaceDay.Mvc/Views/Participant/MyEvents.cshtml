@model List<Enrolment>
@{
    ViewData["Title"] = "My events";
}
<h1 class="rd-page-title">My <span>events</span></h1>

@if (Model.Count == 0)
{
    <div class="rd-panel text-center">
        <i class="bi bi-ticket-perforated display-4 text-muted"></i>
        <h3 class="mt-2">You haven't entered any events yet</h3>
        <a asp-controller="Home" asp-action="Index" class="btn btn-rd mt-2">Find an event</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Location</th><th>Category</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="fw-semibold">@e.EventName</td>
                        <td>@ViewHelpers.FormatDate(e.EventDate)</td>
                        <td>@e.Location</td>
                        <td>@e.CategoryName</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end"><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-rd">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
