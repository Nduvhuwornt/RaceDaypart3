@model EventSummary
<div class="card rd-card h-100">
    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
    {
        <img src="@Model.BannerImageUrl" class="rd-card-img" alt="Banner for @Model.Name" />
    }
    else
    {
        <div class="rd-card-img rd-card-placeholder @ViewHelpers.TypeCss(Model.EventType)">
            <i class="bi @ViewHelpers.TypeIcon(Model.EventType)"></i>
        </div>
    }
    <div class="card-body d-flex flex-column">
        <div class="mb-2">
            <span class="badge rd-type @ViewHelpers.TypeCss(Model.EventType)"><i class="bi @ViewHelpers.TypeIcon(Model.EventType)"></i> @Model.EventType</span>
            <span class="badge rd-distance">@ViewHelpers.FormatDistance(Model.DistanceKm)</span>
        </div>
        <h3 class="rd-card-title">@Model.Name</h3>
        <ul class="rd-meta list-unstyled mb-3">
            <li><i class="bi bi-calendar3"></i> @ViewHelpers.FormatDate(Model.EventDate)</li>
            <li><i class="bi bi-geo-alt-fill"></i> @Model.Location</li>
        </ul>
        <p class="text-muted small flex-grow-1">@ViewHelpers.Truncate(Model.Description, 110)</p>
        <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-rd w-100">View event <i class="bi bi-arrow-right"></i></a>
    </div>
</div>
