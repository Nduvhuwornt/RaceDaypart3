@model HomeIndexViewModel
@{
    ViewData["Title"] = "Upcoming events";
}
<div class="rd-hero">
    <h1>Find your next <span>race</span></h1>
    <p>Browse upcoming runs, walks and cycle events across South Africa and enter in a few clicks.</p>
</div>

<form method="get" asp-action="Index" class="rd-panel row g-3 align-items-end">
    <div class="col-md-5">
        <label for="search" class="form-label">Search</label>
        <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event name or location" />
    </div>
    <div class="col-md-4">
        <label for="type" class="form-label">Event type</label>
        <select id="type" name="type" class="form-select">
            <option value="">All types</option>
            @foreach (var t in EventTypes.All)
            {
                <option value="@t" selected="@(Model.Type == t)">@t</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-rd flex-grow-1"><i class="bi bi-funnel"></i> Filter</button>
        <a asp-action="Index" class="btn btn-outline-rd">Clear</a>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="rd-panel text-center">
        <i class="bi bi-calendar-x display-4 text-muted"></i>
        <h3 class="mt-2">No upcoming events found</h3>
        <p class="text-muted mb-0">Try a different search or event type, or check back soon.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col"><partial name="_EventCard" model="ev" /></div>
        }
    </div>
}
